# ── Anthropic Claude (use agentic-resume.yml workflow) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Microsoft Foundry / Azure OpenAI (use agentic-resume-foundry.yml) ───────
# Endpoint from: AI Foundry portal → your project → Overview → Endpoint
# Format: https://<resource>.cognitiveservices.azure.com/
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-azure-api-key-here
# Optional — defaults to 2024-12-01-preview if not set
AZURE_OPENAI_API_VERSION=2024-12-01-preview
