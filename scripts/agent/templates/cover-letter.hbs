<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{name}} — Cover Letter, {{role}}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { font-size: 10.6px; }
  body {
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
    color: #1a1a1a;
    line-height: 1.55;
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }

  .page {
    max-width: 800px;
    margin: 0 auto;
    padding: 26px 44px;
  }

  .header { margin-bottom: 16px; border-bottom: 2.5px solid #111; padding-bottom: 9px; }
  .header h1 { font-size: 1.9rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .header .subtitle { font-size: 1rem; color: #333; font-weight: 600; margin-top: 2px; }
  .contact-row { display: flex; flex-wrap: wrap; gap: 3px 12px; font-size: 0.86rem; color: #444; margin-top: 5px; }
  .contact-row a { color: #0073bb; text-decoration: none; }
  .contact-row span { white-space: nowrap; }

  .meta { font-size: 0.9rem; color: #555; margin-bottom: 14px; }
  .greeting { font-size: 0.95rem; font-weight: 600; margin-bottom: 10px; }
  .letter p { font-size: 0.95rem; color: #222; margin-bottom: 10px; }
  .signoff { margin-top: 14px; font-size: 0.95rem; }
  .signoff .name { font-weight: 600; }

  @media print {
    html { font-size: 10.6px; }
    body { background: none; }
    .page { padding: 20px 40px; max-width: 100%; }
  }
</style>
</head>
<body>
<div class="page">

  <div class="header">
    <h1>{{{name}}}</h1>
    <div class="subtitle">{{{headline}}}</div>
    <div class="contact-row">
      <span>{{location}}</span>
      <span>|</span>
      <span><a href="mailto:{{email}}">{{email}}</a></span>
      <span>|</span>
      <span><a href="{{website}}">{{websiteDisplay}}</a></span>
      <span>|</span>
      <span><a href="{{linkedin}}">{{linkedinDisplay}}</a></span>
    </div>
  </div>

  <div class="meta">Application for: {{role}}{{#if company}}, {{company}}{{/if}}{{#if location_meta}} ({{location_meta}}){{/if}}</div>

  <div class="greeting">{{salutation}}</div>

  <div class="letter">
    {{#each paragraphs}}
    <p>{{{this}}}</p>
    {{/each}}
  </div>

  <div class="signoff">
    <div>Warm regards,</div>
    <div class="name">{{{name}}}</div>
  </div>

</div>
</body>
</html>
