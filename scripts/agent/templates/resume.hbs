<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{name}} — Resume</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { font-size: 10.2px; }
  body {
    font-family: 'Inter', 'Segoe UI', Arial, sans-serif;
    color: #1a1a1a;
    line-height: 1.45;
    background: #fff;
    -webkit-font-smoothing: antialiased;
  }

  .page {
    max-width: 800px;
    margin: 0 auto;
    padding: 20px 38px;
  }

  .header { text-align: center; margin-bottom: 10px; border-bottom: 2.5px solid #111; padding-bottom: 7px; }
  .header h1 { font-size: 2.2rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
  .header .subtitle { font-size: 1.05rem; color: #333; font-weight: 600; margin-top: 2px; }
  .contact-row { display: flex; justify-content: center; flex-wrap: wrap; gap: 3px 12px; font-size: 0.88rem; color: #444; margin-top: 4px; }
  .contact-row a { color: #0073bb; text-decoration: none; }
  .contact-row span { white-space: nowrap; }

  .section { margin-bottom: 9px; }
  .section-title {
    font-size: 0.92rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.14em; color: #111;
    border-bottom: 1.5px solid #d0d0d0; padding-bottom: 3px; margin-bottom: 6px;
  }

  .summary { font-size: 0.93rem; color: #222; line-height: 1.42; }

  .job { margin-bottom: 8px; break-inside: avoid; page-break-inside: avoid; }
  .job-header { display: flex; justify-content: space-between; align-items: baseline; }
  .job-title { font-size: 0.94rem; font-weight: 600; color: #111; }
  .job-date { font-size: 0.84rem; color: #666; font-weight: 500; white-space: nowrap; }
  .job-company { font-size: 0.89rem; color: #0073bb; font-weight: 500; margin-bottom: 1px; }
  .job ul { padding-left: 15px; }
  .job li { font-size: 0.87rem; color: #222; margin-bottom: 1.5px; line-height: 1.4; }

  .skills-grid { break-inside: avoid; }
  .skill-row { display: flex; gap: 6px; font-size: 0.88rem; margin-bottom: 2px; }
  .skill-label { font-weight: 600; color: #111; min-width: 130px; }
  .skill-value { color: #333; }

  .certs-list { padding-left: 15px; }
  .certs-list li { font-size: 0.87rem; color: #222; margin-bottom: 1.5px; }

  .edu-header { display: flex; justify-content: space-between; align-items: baseline; }
  .edu-title { font-size: 0.94rem; font-weight: 600; }
  .edu-date { font-size: 0.84rem; color: #666; }
  .edu-school { font-size: 0.89rem; color: #0073bb; font-weight: 500; }

  .project { margin-bottom: 6px; }
  .project-title { font-size: 0.92rem; font-weight: 600; color: #111; }
  .project p { font-size: 0.87rem; color: #333; line-height: 1.35; }

  .pub-item { font-size: 0.87rem; color: #222; margin-bottom: 1px; }

  @media print {
    html { font-size: 10.2px; }
    body { background: none; }
    .page { padding: 14px 34px; max-width: 100%; }
  }
</style>
</head>
<body>
<div class="page">

  <div class="header">
    <h1>{{{name}}}</h1>
    <div class="subtitle">{{{headline}}}</div>
    <div class="contact-row">
      <span>{{location}}</span>
      <span>|</span>
      <span><a href="mailto:{{email}}">{{email}}</a></span>
      <span>|</span>
      <span><a href="{{website}}">{{websiteDisplay}}</a></span>
      <span>|</span>
      <span><a href="{{linkedin}}">{{linkedinDisplay}}</a></span>
      <span>|</span>
      <span><a href="{{github}}">{{githubDisplay}}</a></span>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Professional Summary</div>
    <p class="summary">{{{summary}}}</p>
  </div>

  <div class="section">
    <div class="section-title">Core Competencies</div>
    <div class="skills-grid">
      {{#each skills}}
      <div class="skill-row"><span class="skill-label">{{label}}</span><span class="skill-value">{{{value}}}</span></div>
      {{/each}}
    </div>
  </div>

  <div class="section">
    <div class="section-title">Professional Experience</div>
    {{#each experience}}
    <div class="job">
      <div class="job-header">
        <span class="job-title">{{{title}}}</span>
        <span class="job-date">{{dates}}</span>
      </div>
      <div class="job-company">{{{company}}}</div>
      <ul>
        {{#each bullets}}
        <li>{{{this}}}</li>
        {{/each}}
      </ul>
    </div>
    {{/each}}
  </div>

  {{#if projects.length}}
  <div class="section">
    <div class="section-title">Key Solutions &amp; Architecture Projects</div>
    {{#each projects}}
    <div class="project">
      <span class="project-title">{{{title}}}</span>
      <p>{{{description}}}</p>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <div class="section">
    <div class="section-title">Certifications</div>
    <ul class="certs-list">
      {{#each certifications}}
      <li>{{{this}}}</li>
      {{/each}}
    </ul>
  </div>

  <div class="section">
    <div class="section-title">Education</div>
    {{#each education}}
    <div class="edu-header">
      <span class="edu-title">{{{degree}}}</span>
      <span class="edu-date">{{dates}}</span>
    </div>
    <div class="edu-school">{{{school}}}</div>
    {{#if details}}<p style="font-size:0.87rem;color:#333;margin-top:2px">{{{details}}}</p>{{/if}}
    {{/each}}
  </div>

  {{#if publications.length}}
  <div class="section">
    <div class="section-title">Publications &amp; Thought Leadership</div>
    {{#each publications}}
    <p class="pub-item"><a href="{{url}}" style="color:#0073bb;text-decoration:none"><strong>{{{title}}}</strong></a> — {{{description}}}</p>
    {{/each}}
  </div>
  {{/if}}

</div>
</body>
</html>
